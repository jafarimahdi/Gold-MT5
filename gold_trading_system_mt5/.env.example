# ================= STEP 0: credentials =================
# Copy this file to `.env` and fill in your values.
# Edit .env any time (e.g. when Rithmic rotates demo credentials) + restart.

# ---- STEP 1: data feed ----
# Switch provider here: mt5 | demo | databento | rithmic | replay
DATA_SOURCE=mt5

# ====== MT5 (RECOMMENDED for this version - FREE, no card) ======
# Reads data from your running MetaTrader 5 terminal (demo account is fine).
# Gives: ticks with buy/sell side, Level 2 depth, OHLCV candles.
# Does NOT give Level 3 (order events) - brokers don't provide it.
# Requires: Windows + MT5 terminal running + `pip install MetaTrader5`.
MT5_SYMBOL=XAUUSD
DATA_SYMBOL=XAUUSD
MT5_LOGIN=0                       # 0 = use the already-running terminal
MT5_PASSWORD=
MT5_SERVER=

# ====== Databento (full L2+L3, needs a card for $125 free credits) ======
DATABENTO_API_KEY=
DATABENTO_DATASET=GLBX.MDP3            # CME Globex
DATABENTO_SCHEMA=mbo                    # mbo (L3 events) | mbp-10 (L2) | trades
DATABENTO_SYMBOL=GC.n.0                 # gold futures, continuous front-month

# ====== Rithmic (full L2+L3, ~$100/month + conformance test) ======
RITHMIC_USERNAME=
RITHMIC_PASSWORD=
RITHMIC_SYSTEM=Rithmic Paper Trading
RITHMIC_APP_NAME=GoldTradingBot
RITHMIC_APP_VERSION=1.0.0
RITHMIC_URL=rprotocol.rithmic.com:443   # gateway (Chicago production)
RITHMIC_SYMBOL=GC                        # gold futures root
RITHMIC_EXCHANGE=COMEX                   # gold trades on COMEX

# ---- STEP 3: AI (the "brain") ----
# Paste your Gemini API key here. Get one at: https://aistudio.google.com/app/apikey
# Without a key, Step 3 always returns HOLD (so nothing will ever trade).
GEMINI_API_KEY=
# gemini-3.7-flash works well on the free tier (~1,500 requests/day).
# The bot keeps a FALLBACK MODEL LIST in config.py and moves down it
# automatically when Google retires a model. Avoid gemini-3.6-flash (only
# ~20 free requests/day on some accounts).
GEMINI_MODEL=gemini-3.7-flash

# Optional EXTRA Gemini keys (different projects or different Google accounts).
# The bot rotates through them when one runs out of daily quota.
# NOTE: keys from the SAME Google account share ONE quota, so extra keys only
# help if they come from DIFFERENT projects or accounts.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_API_KEY_5=

# AI quota protection — safety rails.
# Free Flash models allow ~1,500 requests/DAY and ~15 requests/MINUTE per
# PROJECT per MODEL. With 3 keys in 3 separate projects that is ~4,500/day.
# Every 1 minute (~1,440/day) is only ~32% of that, so 1 minute is fine.
# Ask the AI when the Step-2 signal is at least this strong.
#   10 = ask on any meaningful signal (AI weighs in often)
#   20 = ask only on strong signals (AI asked rarely)
# The REAL trade gate is the AI's own confidence (>=70%), not this number.
AI_MIN_SIGNAL_STRENGTH=10
# And never more often than this many minutes (1 = every minute; raise only
# if you see "rate-limited" lines often):
AI_MIN_INTERVAL_MINUTES=1
# Hard daily cap (safety only):
AI_MAX_CALLS_PER_DAY=2000
# After a failed/rate-limited key, skip it on later cycles for this long.
# This does NOT pause failover to the next key.
AI_KEY_COOLDOWN_MINUTES=20
# ---- live news headlines for the AI (FREE, Google News RSS, no key) ----
# 1 = fetch real gold / Fed / geopolitics headlines and give them to Gemini
NEWS_ENABLED=1
# re-fetch news at most this often (minutes)
NEWS_CACHE_MINUTES=15
# how many headlines to keep per cycle
NEWS_MAX_HEADLINES=20
# per-request timeout (seconds)
NEWS_TIMEOUT=8

# ---- live macro data for the AI (FREE, Yahoo Finance, no key) ----
# 1 = fetch DXY / US 10-year yield / VIX and give them to Gemini
MACRO_ENABLED=1
# re-fetch macro at most this often (minutes)
MACRO_CACHE_MINUTES=15
# per-request timeout (seconds)
MACRO_TIMEOUT=8

# ---- STEP 4: broker (MetaTrader 5) ----
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ---- MT5 signal bridge (file the EA / indicator reads) ----
# Point to the MT5 Common Files folder, e.g.:
# MT5_SIGNAL_FILE=C:\Users\<you>\AppData\Roaming\MetaQuotes\Terminal\Common\Files\gold_signal.txt
MT5_SIGNAL_FILE=

# ================= runtime =================
TRADING_SYMBOL=XAUUSD
MT5_SYMBOL=XAUUSD              # TRADE (MT5 CFD) market — the CFD your broker offers
TIMEFRAME=M1
DEBUG=0

# MASTER ON/OFF SWITCH for trading:
#   1 = the bot may send BUY/SELL signals
#   0 = analyse only, never trade (safe default)
TRADING_ENABLED=0

# EXECUTION OWNER:
#   none   = analysis only; clear any actionable EA signal
#   python = Python MT5 SDK sends orders; EA receives neutral signal
#   ea     = Python writes actionable signals; only the MQL5 EA sends orders
# Keep this at none until the installation is verified.
EXECUTION_MODE=none

# ---- better-result filters ----
# require the higher timeframes (H1 -> M15 -> M5) to agree with the M1 signal
CONFIRM_ENABLED=1
CONFIRM_TIMEFRAMES=H1,M15,M5
# block trades when the MT5 bid-ask spread is wider than this %
MAX_SPREAD_PCT=0.05
# detect supply/demand (order block) zones from swing points
ORDER_BLOCKS_ENABLED=1

# ---- anti-overtrading guard ----
# no new position within this many minutes of the last one
COOLDOWN_MINUTES=15
# maximum new positions per day
MAX_TRADES_PER_DAY=20

# ---- automatic file maintenance (keeps the app light over time) ----
# 1 = automatically rotate logs, trim CSVs, clean old recordings (once/day)
MAINTENANCE_ENABLED=1
# keep log files for this many days
LOG_RETENTION_DAYS=7
# keep only the latest N decision rows
DECISIONS_LOG_MAX_ROWS=5000
# keep only the latest N trade-outcome rows
OUTCOMES_LOG_MAX_ROWS=2000
# keep recorded sessions for this many days
RECORD_RETENTION_DAYS=30

# DATA (futures feed) market — the market Rithmic/Databento quotes for gold.
# Typically GC (100oz) or MGC (10oz). Used for L2/L3 analysis only.
DATA_SYMBOL=GC
# Optional explicit canonical ids (normally auto-detected from the symbols):
# DATA_MARKET=GC
# TRADE_MARKET=XAUUSD

# Tip: run  python3 setup_markets.py  to pick both markets interactively.

# ================= thresholds =================
CONFIDENCE_THRESHOLD=70       # Step 4 executes only above this %
RISK_PER_TRADE_PCT=1.0
STOP_LOSS_ATR_MULT=1.5
TAKE_PROFIT_ATR_MULT=3.0
LOT_SIZE=0.1                  # fallback fixed size (when equity unknown)

# risk-based position sizing (XAUUSD: 1 lot = 100 oz)
CONTRACT_SIZE=100
ACCOUNT_EQUITY=10000          # fallback when MT5 equity unavailable
MAX_LOT_SIZE=1.0

# ---- News-time behaviour ----
NEWS_WARNING_MINUTES=30       # alert window before an event
NEWS_BLACKOUT_BEFORE_MINUTES=15   # stop trading X min before event
NEWS_BLACKOUT_AFTER_MINUTES=30    # stop trading X min after event
NEWS_WIDEN_STOP_MULT=1.5      # widen SL during news warning
NEWS_REDUCE_SIZE_PCT=0.5      # trade at 50% size during news warning

# ---- Step 2 analysis parameters ----
PRICE_RESOLUTION=0.1
LARGE_ORDER_THRESHOLD=100
CORRELATION_WINDOW=30
ECONOMIC_CALENDAR_TIMEOUT=8

# ---- Step 5 ----
MONITOR_POLL_SECONDS=60

# ---- trading session (weekend / market-closed protection) ----
SESSION_ENFORCE=1              # 0 disables the session check
TRADING_DAYS=0,1,2,3,4         # Monday..Friday (Mon=0 .. Sun=6)
DAILY_BREAK_START=             # optional "HH:MM" UTC daily halt start
DAILY_BREAK_END=               # optional "HH:MM" UTC daily halt end
STALE_DATA_SECONDS=300         # no fresh feed data for this long -> no trading

# ---- risk circuit-breaker ----
DAILY_LOSS_LIMIT_PCT=3.0       # halt for the day if today's loss >= 3% of equity
MAX_DRAWDOWN_PCT=10.0          # halt if equity drawdown >= 10% from peak

# ---- data recording / replay (weekend testing) ----
RECORD_DATA=0                  # 1 = save every live session to data/record_*.json
REPLAY_FILE=                   # path to a recorded file; set DATA_SOURCE=replay

# ---- futures <-> CFD spread monitor ----
SPREAD_ALERT_PCT=2.0           # warn if the basis exceeds 2%
