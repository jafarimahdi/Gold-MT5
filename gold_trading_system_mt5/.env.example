# Gold Trading System — safe configuration template
# Copy this file to .env and fill in local values.
# Never commit .env or place real keys in this file.

# ---------------- broker and market ----------------
BROKER_NAME=Pepperstone
DATA_SOURCE=mt5                         # mt5 | demo | replay | rithmic | databento

# Use the exact symbol shown in the broker's MT5 Market Watch.
MT5_SYMBOL=XAUUSD
TRADING_SYMBOL=XAUUSD
DATA_SYMBOL=XAUUSD
DATA_MARKET=XAUUSD
TRADE_MARKET=XAUUSD

# 0 = use the already-open MT5 terminal.
# Set these only when connecting by account credentials.
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=

# Full path to the Pepperstone terminal. Change this if installed elsewhere.
MT5_TERMINAL_PATH=C:\Program Files\Pepperstone MetaTrader 5\terminal64.exe

# ---------------- futures data providers ----------------
# These settings preserve the futures capability for later use.
DATABENTO_API_KEY=
DATABENTO_DATASET=GLBX.MDP3
DATABENTO_SCHEMA=mbo                  # mbo | mbp-10 | trades
DATABENTO_SYMBOL=GC.n.0

RITHMIC_USERNAME=
RITHMIC_PASSWORD=
RITHMIC_SYSTEM=Rithmic Paper Trading
RITHMIC_APP_NAME=GoldTradingBot
RITHMIC_APP_VERSION=1.0.0
RITHMIC_URL=rprotocol.rithmic.com:443
RITHMIC_SYMBOL=GC
RITHMIC_EXCHANGE=COMEX
RITHMIC_LIB=async_rithmic

# ---------------- Gemini AI ----------------
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.6-flash,gemini-2.5-flash
AI_MIN_SIGNAL_STRENGTH=10
AI_MIN_INTERVAL_MINUTES=1
AI_MAX_CALLS_PER_DAY=2000
# No wait between keys. This only skips a failed key on later cycles.
AI_KEY_COOLDOWN_MINUTES=20
# Maximum wait for one modern Gemini request, in milliseconds.
GEMINI_REQUEST_TIMEOUT_MS=20000

# ---------------- safety and execution ----------------
# Safe defaults for a new installation.
TRADING_ENABLED=0
EXECUTION_MODE=none                     # none | python | ea

CONFIRM_ENABLED=1
CONFIRM_TIMEFRAMES=H1,M15,M5
MAX_SPREAD_PCT=0.05
ORDER_BLOCKS_ENABLED=1
COOLDOWN_MINUTES=15
MAX_TRADES_PER_DAY=20

# ---------------- news and macro ----------------
NEWS_ENABLED=1
NEWS_CACHE_MINUTES=15
NEWS_MAX_HEADLINES=20
NEWS_TIMEOUT=8
NEWS_WARNING_MINUTES=30
NEWS_BLACKOUT_BEFORE_MINUTES=15
NEWS_BLACKOUT_AFTER_MINUTES=30
NEWS_WIDEN_STOP_MULT=1.5
NEWS_REDUCE_SIZE_PCT=0.5

MACRO_ENABLED=1
MACRO_CACHE_MINUTES=15
MACRO_TIMEOUT=8

# ---------------- MT5 signal bridge ----------------
# Required only for EA mode. Confirm the path with MT5 -> File -> Open Data Folder.
MT5_SIGNAL_FILE=
SIGNAL_MAX_AGE_SECONDS=180

# ---------------- risk and order parameters ----------------
TIMEFRAME=M1
RISK_PER_TRADE_PCT=1.0
STOP_LOSS_ATR_MULT=1.5
TAKE_PROFIT_ATR_MULT=3.0
LOT_SIZE=0.01
CONTRACT_SIZE=100
ACCOUNT_EQUITY=10000
MAX_LOT_SIZE=1.0

# ---------------- sessions and health ----------------
SESSION_ENFORCE=1
TRADING_DAYS=0,1,2,3,4
DAILY_BREAK_START=
DAILY_BREAK_END=
STALE_DATA_SECONDS=300
MONITOR_POLL_SECONDS=60

# ---------------- risk circuit breaker ----------------
DAILY_LOSS_LIMIT_PCT=3.0
MAX_DRAWDOWN_PCT=10.0

# ---------------- recording and retention ----------------
RECORD_DATA=0
REPLAY_FILE=
MAINTENANCE_ENABLED=1
LOG_RETENTION_DAYS=7
DECISIONS_LOG_MAX_ROWS=5000
OUTCOMES_LOG_MAX_ROWS=2000
RECORD_RETENTION_DAYS=30
SPREAD_ALERT_PCT=2.0
DEBUG=0
