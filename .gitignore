# Secrets
.env
.env.*
!.env.example

# Python virtual environments
venv/
.venv/

# Python cache and compiled files
__pycache__/
*.py[cod]

# Runtime logs and generated data at any depth
**/logs/*.log
**/data/*.json
**/data/*.csv
**/data/*.lock
**/data/*.txt
**/data/*.html
!**/data/.gitkeep
!**/logs/.gitkeep

# Local transfer files
*.patch

# Operating-system files
.DS_Store
Thumbs.db
